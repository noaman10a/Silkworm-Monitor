{
  "version": 1,
  "author": "Noaman Nazeer Ahamed (noaman10a)",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht1", "top": -150, "left": -120, "attrs": { "temperature": "26.5", "humidity": "75" } },
    { "type": "wokwi-potentiometer", "id": "soil1", "top": -150, "left": 120, "attrs": { "label": "Soil Moisture" } },
    { "type": "wokwi-potentiometer", "id": "gas1", "top": 120, "left": -180, "attrs": { "label": "MQ-135 Gas" } },
    { "type": "wokwi-photoresistor-sensor", "id": "ldr1", "top": 120, "left": 180, "attrs": {} },
    { "type": "wokwi-buzzer", "id": "bz1", "top": -100, "left": 20, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "dht1:SDA", "esp:4", "blue", [ "v0" ] ],
    [ "soil1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "soil1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "soil1:SIG", "esp:34", "green", [ "v0" ] ],
    [ "gas1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "gas1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "gas1:SIG", "esp:35", "orange", [ "v0" ] ],
    [ "ldr1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "ldr1:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "ldr1:AO", "esp:32", "yellow", [ "v0" ] ],
    [ "bz1:1", "esp:5", "purple", [ "v0" ] ],
    [ "bz1:2", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
