# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-to-a-secure-random-hex

# Server Port & Host
PORT=5000
HOST=0.0.0.0

# Database Configuration
# Local SQLite default (used if DATABASE_URL is not set)
DATABASE_URL=sqlite:///silkworm_monitor.db
# For PostgreSQL (Production):
# DATABASE_URL=postgresql://user:password@localhost:5432/silkworm_db

# Timezone Setting (Default: Asia/Kolkata for Indian Standard Time)
TIMEZONE=Asia/Kolkata

# Data Retention Policy in Days (Set to 0 to disable automated deletion)
DATA_RETENTION_DAYS=30

# Telegram Alert Configuration (Optional - Future Phase)
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id

